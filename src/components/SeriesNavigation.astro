---
import type { CollectionEntry } from 'astro:content';
import { getSeriesPosts, seriesItems, seriesSource, seriesTitle } from '../lib/series';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { series, lang, slug } = post.data;
const siblings = series ? seriesItems(await getSeriesPosts(series, lang), slug) : [];
const currentIndex = siblings.findIndex((item) => item.current);
const previous = currentIndex > 0 ? siblings[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : undefined;
const showSeries = siblings.length > 1;
const step = currentIndex >= 0 ? `${currentIndex + 1}/${siblings.length}` : '';
const name = series ? seriesTitle(series, lang) : '';
const source = series ? seriesSource(series, lang) : undefined;
const copy = lang === 'en'
  ? { previous: 'Previous', next: 'Next', label: 'Series navigation' }
  : { previous: 'Trước', next: 'Tiếp', label: 'Mục lục series' };
---

{showSeries && (
  <>
    {source && (
      <p class="series-origin">
        <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>
      </p>
    )}
    <nav class="series-pager" aria-label={copy.label}>
      {previous ? (
        <a class="series-pager-link" href={previous.href}>
          <span class="series-pager-dir">{copy.previous}</span>
          <span class="series-pager-title">{previous.label}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="series-pager-link next" href={next.href}>
          <span class="series-pager-dir">{copy.next}</span>
          <span class="series-pager-title">{next.label}</span>
        </a>
      ) : <span />}
    </nav>

    <div class="series-float">
      <button type="button" class="series-fab" aria-expanded="false" aria-controls="series-panel" aria-label={`${name}, ${step}`}>
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <path fill="currentColor" d="M7 5h14v2H7V5zm0 6h14v2H7v-2zm0 6h14v2H7v-2zM3 4.5A1.5 1.5 0 1 1 3 7.5 1.5 1.5 0 0 1 3 4.5zm0 6A1.5 1.5 0 1 1 3 13.5 1.5 1.5 0 0 1 3 10.5zm0 6A1.5 1.5 0 1 1 3 19.5 1.5 1.5 0 0 1 3 16.5z" />
        </svg>
        <span>{step}</span>
      </button>
      <nav id="series-panel" class="series-panel" aria-label={copy.label}>
        <div class="series-card">
          <p>{name}</p>
          <ol>
            {siblings.map((item) => (
              <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ol>
          {source && (
            <a class="series-source" href={source.url} target="_blank" rel="noopener noreferrer">
              {source.label}<span aria-hidden="true"> ↗</span>
            </a>
          )}
        </div>
      </nav>
    </div>
  </>
)}

<script>
  const root = document.querySelector('.series-float');
  const button = root?.querySelector('.series-fab');
  if (root instanceof HTMLElement && button instanceof HTMLButtonElement) {
    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', String(open));
    };
    button.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!root.classList.contains('is-open'));
    });
    document.addEventListener('pointerdown', (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .series-float { position: fixed; top: 6.5rem; right: 1rem; z-index: 40; }
  .series-fab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .1rem; width: 3rem; min-height: 3rem; padding: .45rem; border: 1px solid #262b33; border-radius: 1rem; background: rgba(11,11,15,.88); color: rgba(255,255,255,.86); box-shadow: 0 12px 32px rgba(0,0,0,.35); backdrop-filter: blur(12px); cursor: pointer; }
  .series-fab span { color: #868f97; font-size: .68rem; font-weight: 650; line-height: 1; }
  .series-panel { display: none; position: absolute; top: 0; right: 100%; padding-right: .6rem; }
  .series-float:hover .series-panel, .series-float:focus-within .series-panel, .series-float.is-open .series-panel { display: block; }
  .series-card { width: min(24rem, calc(100vw - 5rem)); padding: 1rem .8rem; border: 1px solid #262b33; border-radius: 1rem; background: #0b0b0f; box-shadow: 0 18px 45px rgba(0,0,0,.42); }
  .series-card p { margin: 0 .55rem .65rem; color: #868f97; font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .series-card ol { margin: 0; padding: 0; list-style: none; counter-reset: item; display: grid; gap: .15rem; }
  .series-card li { counter-increment: item; }
  .series-card a { display: grid; grid-template-columns: 1.4rem 1fr; gap: .45rem; padding: .48rem .6rem; border-radius: .5rem; color: #868f97; font-size: .9rem; line-height: 1.35; text-decoration: none; }
  .series-card a::before { content: counter(item); color: #868f97; font-size: .78rem; padding-top: .08rem; }
  .series-card a:hover { color: white; background: rgba(255,255,255,.05); }
  .series-card a[aria-current='page'] { color: white; font-weight: 650; background: rgba(139,92,246,.17); }
  .series-card a[aria-current='page']::before { color: #a78bfa; }
  .series-card .series-source { display: inline-flex; grid-template-columns: none; margin: .7rem .55rem 0; padding: .45rem 0 0; border-radius: 0; border-top: 1px solid #262b33; color: #a78bfa; font-size: .78rem; font-weight: 650; }
  .series-card .series-source::before { content: none; }
  .series-card .series-source:hover { color: #c4b5fd; background: transparent; }
  .series-origin { max-width: 760px; margin: 2.25rem auto 0; color: #868f97; font-size: .95rem; line-height: 1.5; }
  .series-origin a { color: #a78bfa; text-decoration: underline; text-underline-offset: .18em; }
  .series-origin a:hover { color: #c4b5fd; }
  .series-pager { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; max-width: 760px; margin: 1.5rem auto 0; padding-top: 1.5rem; border-top: 1px solid #262b33; }
  .series-pager-link { display: flex; flex-direction: column; gap: .2rem; min-height: 4.5rem; padding: .9rem 1rem; border: 1px solid #262b33; border-radius: .75rem; color: rgba(255,255,255,.86); text-decoration: none; }
  .series-pager-link:hover { border-color: rgba(167,139,250,.6); background: rgba(139,92,246,.08); }
  .series-pager-link.next { align-items: flex-end; text-align: right; }
  .series-pager-dir { color: #868f97; font-size: .7rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  .series-pager-title { font-size: .95rem; font-weight: 600; line-height: 1.3; }
  @media (min-width: 68rem) { .series-float { right: auto; left: calc(50% + 480px + 1.1rem); } }
  @media (max-width: 540px) {
    .series-float { top: auto; right: 1rem; bottom: 1.15rem; }
    .series-panel { top: auto; right: 0; bottom: 100%; width: min(24rem, calc(100vw - 2rem)); padding: 0 0 .6rem; }
    .series-card { width: 100%; }
    .series-pager { grid-template-columns: 1fr; }
    .series-pager-link.next { align-items: flex-start; text-align: left; }
  }
</style>
